{
  "name": "@omnizapi/connect",
  "version": "1.0.4",
  "description": "Omnizapi SDK for browser applications",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "browser": "dist/esm/index.mjs",
  "unpkg": "dist/omnizapi.min.js",
  "jsdelivr": "dist/omnizapi.min.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/scripts/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "rimraf dist && npm run build:types && dotenv -e .env.local -- node esbuild.config.mjs --watch",
    "build": "rimraf dist && npm run build:types && node esbuild.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint src __tests__ scripts --ext .ts,.mts,.mjs",
    "test": "jest",
    "test:package": "node scripts/test-package.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run check",
    "version": "node scripts/sync-version.mjs"
  },
  "keywords": [
    "omnizapi",
    "sdk",
    "messaging"
  ],
  "author": "FourPixel IT",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "playwright": "^1.63.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  }
}
